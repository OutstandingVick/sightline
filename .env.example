# Copy these lines into ~/.hermes/.env (or run /sightline setup to create a devnet wallet).
# Wallet secret key: base58, or the JSON byte array from a Solana CLI keypair file. Never commit it.
SIGHTLINE_SECRET_KEY=
# Solana RPC. Default: https://api.devnet.solana.com
# SIGHTLINE_RPC_URL=https://api.devnet.solana.com
# Mainnet is refused unless this is 1. Real funds — read the README's Mainnet section first.
# SIGHTLINE_ALLOW_MAINNET=0
